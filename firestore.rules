rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function sameUser(uid) { return signedIn() && request.auth.uid == uid; }
    function exact(data, fields) { return data.keys().hasOnly(fields) && data.keys().hasAll(fields); }
    function metadata(data, revision) { return data.schemaVersion == 1 && data.revision == revision && data.updatedBy == request.auth.uid && data.updatedAt == request.time; }
    function nextRevision() { return request.resource.data.revision is int && request.resource.data.revision == resource.data.revision + 1; }
    function membership(tenantId, uid) { return /databases/$(database)/documents/playbookTenants/$(tenantId)/members/$(uid); }
    function member(tenantId) { return signedIn() && exists(membership(tenantId, request.auth.uid)); }
    function owner(tenantId) { return member(tenantId) && get(membership(tenantId, request.auth.uid)).data.role == "owner"; }
    function validName(value) { return value is string && value.size() >= 1 && value.size() <= 80 && value == value.trim() && !value.matches('.*[\\x00-\\x1F\\x7F].*'); }
    function teacherRoot(uid) { return /databases/$(database)/documents/playbookTeachers/$(uid); }
    function room(tenantId, roomId) { return /databases/$(database)/documents/playbookTenants/$(tenantId)/rooms/$(roomId); }
    function validRoot(uid, data, revision) { return exact(data, ["schemaVersion", "revision", "tenantId", "roomId", "updatedAt", "updatedBy"]) && metadata(data, revision) && data.updatedBy == uid; }
    function validPrivate(domain, data, revision) {
      return metadata(data, revision) && (
        domain == "plan" && exact(data, ["schemaVersion", "revision", "updatedAt", "updatedBy", "plan"]) ||
        domain == "progress" && exact(data, ["schemaVersion", "revision", "updatedAt", "updatedBy", "teacherProgress"]) ||
        domain == "preferences" && exact(data, ["schemaVersion", "revision", "updatedAt", "updatedBy", "preferences"]) ||
        domain == "content" && exact(data, ["schemaVersion", "revision", "updatedAt", "updatedBy", "checklist", "classes", "lessonGuides", "specialEvents", "resources", "notes", "tombstones"])
      );
    }
    function validArtifact(value) { return exact(value, ["schemaVersion", "artifactId", "projectNumber", "stageId", "contributionIndex", "status", "createdAt", "updatedAt", "visits"]) && value.schemaVersion == 1 && value.artifactId == "tech-terrarium-2026-27" && value.projectNumber == 2 && value.stageId in ["define", "prepare", "base", "systems", "test"] && value.contributionIndex is int && value.contributionIndex >= 0 && value.contributionIndex <= 2 && value.status in ["active", "parked", "complete"] && value.createdAt is timestamp && value.updatedAt is timestamp && value.visits is list; }
    function validProgress(value) { return exact(value, ["projectNumber", "stageId", "contributionIndex", "status", "updatedAt"]) && value.projectNumber == 2 && value.stageId in ["define", "prepare", "base", "systems", "test"] && value.contributionIndex is int && value.contributionIndex >= 0 && value.contributionIndex <= 2 && value.status in ["active", "parked", "complete"] && value.updatedAt is timestamp; }
    function artifactEnvelope(data, revision) { return exact(data, ["schemaVersion", "revision", "updatedAt", "updatedBy", "value"]) && metadata(data, revision) && validArtifact(data.value); }
    function progressEnvelope(data, revision) { return exact(data, ["schemaVersion", "revision", "updatedAt", "updatedBy", "value"]) && metadata(data, revision) && validProgress(data.value); }
    function progressMatches(artifact, progress) { return artifact.projectNumber == progress.projectNumber && artifact.stageId == progress.stageId && artifact.contributionIndex == progress.contributionIndex && artifact.status == progress.status && artifact.updatedAt == progress.updatedAt; }

    match /playbookTeachers/{uid} {
      allow read: if sameUser(uid);
      allow create: if sameUser(uid) && validRoot(uid, request.resource.data, 1) && getAfter(membership(request.resource.data.tenantId, uid)).data.roomId == request.resource.data.roomId;
      allow update: if sameUser(uid) && nextRevision() && validRoot(uid, request.resource.data, resource.data.revision + 1) && request.resource.data.tenantId == resource.data.tenantId && request.resource.data.roomId == resource.data.roomId;
      allow delete: if false;
      match /private/{domain} {
        allow read: if sameUser(uid) && domain in ["plan", "progress", "preferences", "content"];
        allow create: if sameUser(uid) && domain in ["plan", "progress", "preferences", "content"] && validPrivate(domain, request.resource.data, 1);
        allow update: if sameUser(uid) && domain in ["plan", "progress", "preferences", "content"] && nextRevision() && validPrivate(domain, request.resource.data, resource.data.revision + 1);
        allow delete: if false;
      }
    }

    match /playbookTenants/{tenantId} {
      allow read: if member(tenantId);
      allow create: if signedIn() && exact(request.resource.data, ["schemaVersion", "revision", "tenantId", "name", "ownerUid", "createdAt", "updatedAt", "updatedBy"]) && metadata(request.resource.data, 1) && request.resource.data.tenantId == tenantId && request.resource.data.ownerUid == request.auth.uid && request.resource.data.createdAt == request.time && validName(request.resource.data.name);
      allow update, delete: if false;
      match /members/{uid} {
        allow read: if sameUser(uid) || owner(tenantId);
        allow create: if sameUser(uid) && exact(request.resource.data, ["schemaVersion", "revision", "uid", "tenantId", "roomId", "role", "createdAt", "updatedAt", "updatedBy", "invitationRef"]) && metadata(request.resource.data, 1) && request.resource.data.uid == uid && request.resource.data.tenantId == tenantId && request.resource.data.createdAt == request.time && (
          request.resource.data.role == "owner" && request.resource.data.invitationRef == null && getAfter(/databases/$(database)/documents/playbookTenants/$(tenantId)).data.ownerUid == uid && getAfter(room(tenantId, request.resource.data.roomId)).data.tenantId == tenantId && getAfter(teacherRoot(uid)).data.tenantId == tenantId ||
          request.resource.data.role == "teacher" && request.resource.data.invitationRef is string && request.resource.data.invitationRef.matches('^[0-9a-f]{64}$') && getAfter(/databases/$(database)/documents/playbookInvites/$(request.resource.data.invitationRef)).data.usedBy == uid && getAfter(teacherRoot(uid)).data.roomId == request.resource.data.roomId
        );
        allow update, delete: if false;
      }
      match /rooms/{roomId} {
        allow read: if member(tenantId);
        allow create: if signedIn() && exact(request.resource.data, ["schemaVersion", "revision", "tenantId", "roomId", "name", "createdAt", "updatedAt", "updatedBy"]) && metadata(request.resource.data, 1) && request.resource.data.tenantId == tenantId && request.resource.data.roomId == roomId && request.resource.data.createdAt == request.time && validName(request.resource.data.name);
        allow update, delete: if false;
        match /artifacts/{artifactId} {
          allow read: if member(tenantId);
          allow create: if signedIn() && artifactId == "tech-terrarium-2026-27" && artifactEnvelope(request.resource.data, 1) && getAfter(membership(tenantId, request.auth.uid)).data.role == "owner" && getAfter(/databases/$(database)/documents/playbookTenants/$(tenantId)/rooms/$(roomId)/projectProgress/$(artifactId)).data.revision == 1 && progressMatches(request.resource.data.value, getAfter(/databases/$(database)/documents/playbookTenants/$(tenantId)/rooms/$(roomId)/projectProgress/$(artifactId)).data.value);
          allow update: if member(tenantId) && artifactId == "tech-terrarium-2026-27" && nextRevision() && artifactEnvelope(request.resource.data, resource.data.revision + 1) && request.resource.data.value.visits.size() == resource.data.value.visits.size() + 1 && getAfter(/databases/$(database)/documents/playbookTenants/$(tenantId)/rooms/$(roomId)/projectProgress/$(artifactId)).data.revision == request.resource.data.revision && progressMatches(request.resource.data.value, getAfter(/databases/$(database)/documents/playbookTenants/$(tenantId)/rooms/$(roomId)/projectProgress/$(artifactId)).data.value);
          allow delete: if false;
        }
        match /projectProgress/{projectId} {
          allow read: if member(tenantId);
          allow create: if signedIn() && projectId == "tech-terrarium-2026-27" && progressEnvelope(request.resource.data, 1) && getAfter(membership(tenantId, request.auth.uid)).data.role == "owner" && getAfter(/databases/$(database)/documents/playbookTenants/$(tenantId)/rooms/$(roomId)/artifacts/$(projectId)).data.revision == 1 && progressMatches(getAfter(/databases/$(database)/documents/playbookTenants/$(tenantId)/rooms/$(roomId)/artifacts/$(projectId)).data.value, request.resource.data.value);
          allow update: if member(tenantId) && projectId == "tech-terrarium-2026-27" && nextRevision() && progressEnvelope(request.resource.data, resource.data.revision + 1) && getAfter(/databases/$(database)/documents/playbookTenants/$(tenantId)/rooms/$(roomId)/artifacts/$(projectId)).data.revision == request.resource.data.revision && progressMatches(getAfter(/databases/$(database)/documents/playbookTenants/$(tenantId)/rooms/$(roomId)/artifacts/$(projectId)).data.value, request.resource.data.value);
          allow delete: if false;
        }
      }
    }

    match /playbookInvites/{inviteHash} {
      allow read: if signedIn() && inviteHash.matches('^[0-9a-f]{64}$') && (resource.data.usedBy == null && resource.data.expiresAt > request.time || resource.data.createdBy == request.auth.uid || resource.data.usedBy == request.auth.uid || owner(resource.data.tenantId));
      allow create: if signedIn() && inviteHash.matches('^[0-9a-f]{64}$') && exact(request.resource.data, ["schemaVersion", "revision", "tenantId", "roomId", "createdBy", "createdAt", "expiresAt", "usedBy", "usedAt", "updatedAt", "updatedBy"]) && metadata(request.resource.data, 1) && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time && request.resource.data.expiresAt == request.time + duration.value(7, 'd') && request.resource.data.usedBy == null && request.resource.data.usedAt == null && (owner(request.resource.data.tenantId) || getAfter(membership(request.resource.data.tenantId, request.auth.uid)).data.role == "owner");
      allow update: if signedIn() && inviteHash.matches('^[0-9a-f]{64}$') && resource.data.revision == 1 && request.resource.data.revision == 2 && request.resource.data.diff(resource.data).unchangedKeys().hasAll(["schemaVersion", "tenantId", "roomId", "createdBy", "createdAt", "expiresAt"]) && request.resource.data.usedBy == request.auth.uid && request.resource.data.usedAt == request.time && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time && resource.data.usedBy == null && resource.data.expiresAt > request.time && getAfter(membership(resource.data.tenantId, request.auth.uid)).data.role == "teacher" && getAfter(teacherRoot(request.auth.uid)).data.tenantId == resource.data.tenantId;
      allow delete: if false;
    }
  }
}
